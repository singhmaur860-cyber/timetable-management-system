PROJECT_NAME="University Timetable Management Platform"
API_V1_STR="/api"
SECRET_KEY="super-secret-development-key-change-in-production-min-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# For local zero-setup execution, SQLite file. When running in Docker/Postgres, use postgresql://...
DATABASE_URL="sqlite:///./timetable.db"

# CORS Origins
BACKEND_CORS_ORIGINS=["*"]

# Demo Admin Credentials
FIRST_SUPERUSER="admin@university.com"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_NUM_WORKERS=8
